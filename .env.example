# Variables para `docker compose up` desde la raiz. Copiar a `.env` y ajustar.
# Para produccion real: DJANGO_HTTPS=true, secretos largos y dominios propios.

DJANGO_SETTINGS_MODULE=config.settings.production
# Version publicada (1, 2 o 3). Tambien se usa para construir el frontend en Docker.
APP_VERSION=1
DJANGO_SECRET_KEY=change-me-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_HTTPS=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=boticas
POSTGRES_USER=boticas_user
POSTGRES_PASSWORD=boticas_local_password
DATABASE_URL=postgresql://boticas_user:boticas_local_password@db:5432/boticas
POSTGRES_SSLMODE=disable

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
JWT_REFRESH_COOKIE_NAME=boticas_refresh
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
# Con app.midominio.com y api.midominio.com usar .midominio.com
JWT_COOKIE_DOMAIN=

# Adjuntos: en produccion usar S3 (AWS u otro compatible). MinIO local: --profile s3 y USE_S3=true
USE_S3=false
AWS_ACCESS_KEY_ID=boticas_local
AWS_SECRET_ACCESS_KEY=boticas_local_secret
AWS_STORAGE_BUCKET_NAME=boticas-local
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# Frontend (se incrusta en el build de la imagen web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false

# Registro de boticas: consulta gratuita de RUC (servicio "ruc" de compose) y limite de registros por IP.
RUC_API_TOKEN=local-ruc-token
SIGNUP_THROTTLE_RATE=5/hour
