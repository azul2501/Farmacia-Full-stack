# Variables para compose.prod.yml. En el servidor: cp .env.production.example .env
# Generar secretos con:  openssl rand -base64 48 | tr -d '\n/+='

# Dominios (registros DNS tipo A apuntando a la IP del servidor)
APP_DOMAIN=app.midominio.com
API_DOMAIN=api.midominio.com
# Cookie de refresh compartida entre app. y api.
JWT_COOKIE_DOMAIN=.midominio.com
# Correo para avisos de Let's Encrypt
ACME_EMAIL=tu-correo-personal@ejemplo.com

DJANGO_SECRET_KEY=
# Version publicada del producto (1 = V1)
APP_VERSION=1
# Token interno del servicio gratuito de consulta de RUC (cualquier valor largo y aleatorio)
RUC_API_TOKEN=
POSTGRES_DB=boticas
POSTGRES_USER=boticas_user
POSTGRES_PASSWORD=

# Ajustar segun la RAM del servidor (4 GB: 3 workers / 2 de concurrencia)
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2

# Adjuntos: false = volumen local "media". Para S3 compatible (Cloudflare R2, Backblaze B2...) poner true.
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
